# Database — Option 1: Connection string (Render provides this)
DATABASE_URL=postgresql://user:password@host:5432/feedback

# Database — Option 2: Individual vars (local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Set to 'false' to disable SSL (local dev only)
DB_SSL=false

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated allowed origins (defaults to * if not set)
ALLOWED_ORIGINS=http://localhost:5174
