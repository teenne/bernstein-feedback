# ===========================================================
# Bernstein Feedback — Server config
# ===========================================================

# -----------------------------------------------------------
# MODE A — Local PostgreSQL (dev)
# -----------------------------------------------------------
# Used when DATABASE_URL is empty or contains <placeholders>.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# -----------------------------------------------------------
# MODE B — Cloud / Supabase
# -----------------------------------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Leave the <placeholders> to stay in local mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------
# Server
# -----------------------------------------------------------
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5174

# -----------------------------------------------------------
# Email (Gmail SMTP)
# -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Bernstein Feedback <your-account@gmail.com>"


# -----------------------------------------------------------
# Tier 2: AI clustering (OpenAI embeddings)
# -----------------------------------------------------------
# When set, the server runs a cluster worker every 30s. It embeds new
# feedback via OpenAI's text-embedding-3-small (~$0.02 per 1M tokens)
# and groups similar tickets so the admin UI shows duplicates as
# "× N" badges and the AI agent API (/api/v1/agent/backlog) returns
# a deduplicated, priority-scored backlog.
# Leave blank to disable — feedback submits normally, just without
# AI deduplication.
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cluster worker tuning (optional — defaults shown)
# CLUSTER_POLL_INTERVAL_MS=30000
# CLUSTER_BATCH_SIZE=10
# CLUSTER_SIMILARITY_THRESHOLD=0.85    # 0-1, higher = stricter grouping

# -----------------------------------------------------------
# BYOK — bring-your-own OpenAI key per project
# -----------------------------------------------------------
# When set, the admin UI lets paid-plan owners store their own OpenAI
# key per project (encrypted at rest via pgcrypto.pgp_sym_encrypt).
# The cluster worker picks the project's key before each embedding
# call, falling back to OPENAI_API_KEY above if no BYOK key is set.
#
# Use a random 32+ char secret. Rotating this secret invalidates ALL
# stored BYOK keys — owners will need to re-enter them. Never commit.
# AI_KEY_ENCRYPTION_SECRET=replace-with-32+-chars-of-random-bytes
