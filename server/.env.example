# ===========================================================
# Bernstein Feedback — Server config
# ===========================================================
# Supports TWO database modes. Pick one.

# -----------------------------------------------------------
# MODE A — Local PostgreSQL (dev)
# -----------------------------------------------------------
# Used when DATABASE_URL is empty or contains <placeholders>.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# -----------------------------------------------------------
# MODE B — Cloud / Supabase
# -----------------------------------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Leave the <placeholders> to stay in local mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------
# Server
# -----------------------------------------------------------
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5174

# -----------------------------------------------------------
# Email (Gmail SMTP)
# -----------------------------------------------------------
# Gmail setup (one-time):
#   1. Turn on 2FA: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-char App Password below — NOT your Google password.
# Gmail's free tier: ~500 emails/day per account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Bernstein Feedback <your-account@gmail.com>"

# Optional — public URL to the BERNSTEIN hex logo (40x40 or similar).
# When set, emails render the real logo in the header. When blank,
# emails fall back to a text wordmark with a 🐞 emoji.
# Upload apps/admin/public/Logo.png to any public host (S3, Imgur,
# your website's /public folder, etc.) and paste the URL here.
# BERNSTEIN_LOGO_URL=https://your-cdn.example.com/bernstein-logo.png

# Email worker tuning (optional — defaults shown)
# EMAIL_POLL_INTERVAL_MS=30000
# EMAIL_MAX_ATTEMPTS=3
# EMAIL_BATCH_SIZE=10
