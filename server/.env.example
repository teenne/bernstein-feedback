# ===========================================================
# Bernstein Feedback — Server config
# ===========================================================

# -----------------------------------------------------------
# MODE A — Local PostgreSQL (dev)
# -----------------------------------------------------------
# Used when DATABASE_URL is empty or contains <placeholders>.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL=false

# -----------------------------------------------------------
# MODE B — Cloud / Supabase
# -----------------------------------------------------------
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
# Leave the <placeholders> to stay in local mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------
# Server
# -----------------------------------------------------------
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5174

# -----------------------------------------------------------
# Email (Gmail SMTP)
# -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
SMTP_FROM="Bernstein Feedback <your-account@gmail.com>"


# -----------------------------------------------------------
# Tier 2: AI clustering (OpenAI embeddings)
# -----------------------------------------------------------
# When set, the server runs a cluster worker every 30s. It embeds new
# feedback via OpenAI's text-embedding-3-small (~$0.02 per 1M tokens)
# and groups similar tickets so the admin UI shows duplicates as
# "× N" badges and the AI agent API (/api/v1/agent/backlog) returns
# a deduplicated, priority-scored backlog.
# Leave blank to disable — feedback submits normally, just without
# AI deduplication.
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cluster worker tuning (optional — defaults shown)
# CLUSTER_POLL_INTERVAL_MS=30000
# CLUSTER_BATCH_SIZE=10
# CLUSTER_SIMILARITY_THRESHOLD=0.85    # 0-1, higher = stricter grouping

# -----------------------------------------------------------
# BYOK — bring-your-own OpenAI key per project
# -----------------------------------------------------------
# When set, the admin UI lets paid-plan owners store their own OpenAI
# key per project (encrypted at rest via pgcrypto.pgp_sym_encrypt).
# The cluster worker picks the project's key before each embedding
# call, falling back to OPENAI_API_KEY above if no BYOK key is set.
#
# Use a random 32+ char secret. Rotating this secret invalidates ALL
# stored BYOK keys — owners will need to re-enter them. Never commit.
# AI_KEY_ENCRYPTION_SECRET=replace-with-32+-chars-of-random-bytes

# -----------------------------------------------------------
# Auth — JWT signing secret
# -----------------------------------------------------------
# REQUIRED in production. The server refuses to boot with NODE_ENV=production
# unless this is set, because otherwise JWT auth falls back to a hardcoded
# development secret (insecure). In dev it may stay unset.
# Generate: `openssl rand -hex 32`
# JWT_SECRET=replace-with-32+-chars-of-random-bytes

# Optional: enables admins logged in via Supabase Auth to call Node
# server routes (e.g. Settings → Agent Webhook URL, Ask the agent).
# Without this, only users authenticated through the local JWT flow can
# hit protected Node endpoints; Supabase-logged-in admins get 401.
#
# Where to find it:
#   Supabase Dashboard → Project Settings → API → JWT Secret
# Copy the "JWT Secret" value (not the anon/service-role keys).
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# For NEWER Supabase projects using asymmetric (ES256/RS256) signing,
# HS256 shared-secret verification above won't work — tokens are signed
# with a private key and must be verified against the public JWKS.
# When SUPABASE_URL is set, the server fetches the project's JWKS from
# https://<ref>.supabase.co/auth/v1/.well-known/jwks.json and verifies
# tokens that way. Also auto-derived from DATABASE_SUP_URL if that's
# set, so most deployments won't need to set this explicitly.
# SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------
# Public feedback endpoint — rate limiting
# -----------------------------------------------------------
# Keyed by (ip + project_id). Protects the anonymous POST /api/feedback
# endpoint from abuse that would burn plan limits, fill the DB, and
# fan out resolve emails. Defaults shown.
# FEEDBACK_RATE_LIMIT_WINDOW_MS=60000
# FEEDBACK_RATE_LIMIT_MAX=20

# -----------------------------------------------------------
# Tier 2: Agent worker — automatic fix proposals (no webhook needed)
# -----------------------------------------------------------
# When AGENT_WORKER_ENABLED=true, the server polls every
# AGENT_POLL_INTERVAL_MS for auto-resolvable clusters on paid projects
# that have a repo_url set (Settings → Agent Webhook URL → GitHub Repo URL).
#
# For each cluster it:
#   1. git clone --depth=1 <repo_url> to a temp dir
#   2. Searches for files matching the bug keywords
#   3. Calls GPT-4o to generate a unified diff
#   4. Writes proposed_fix directly to the clusters table
#
# Uses the same OPENAI_API_KEY / BYOK key as the cluster worker.
# Requires `git` to be installed on the server (standard on Linux/Mac).
#
# For private GitHub repos, set AGENT_GIT_TOKEN to a Personal Access
# Token (PAT) with `contents: read` scope. It is injected into the
# clone URL and never stored in the DB.
#
# AGENT_WORKER_ENABLED=true
# AGENT_POLL_INTERVAL_MS=300000     # 5 minutes (default)
# AGENT_BATCH_SIZE=3


# -----------------------------------------------------------
# PostHog webhook signing (optional, recommended for production)
# -----------------------------------------------------------
# When set, POST /api/v1/integrations/posthog/:projectId/error requires a
# valid `x-posthog-signature` header — HMAC-SHA256 of the raw body using
# this secret. Configure the same value on the PostHog webhook destination.
# When unset, X-API-Key alone guards the webhook (fine for local/test,
# less good in production).
# Generate: `openssl rand -hex 32`
# POSTHOG_WEBHOOK_SECRET=
